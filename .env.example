### Example .env file
# You can copy this to .env and fill out the values.


### Database parameters
# Census vintage ID; this governs which vintage to input from and write to for data ingest and server runtime default
VINTAGE=acs2024_5yr

# PostgreSQL connection URL
DATABASE_URL=

# Optional source PostgreSQL connection URL for sql-based raw ingest
SOURCE_DATABASE_URL=

# Raw ingestion source mode: dump|sql
# dump = official ACS Summary File .dat files (2018+ 5-year)
# sql  = Census Reporter SQL schema in SOURCE_DATABASE_URL
RAW_INGEST_MODE=sql


### API server parameters
# API server port (default: 3000)
PORT_SERVER=3000


### Client parameters
# Vite dev server port (default: 5173)
PORT_CLIENT=5173

# Frontend mount path
# Dev default: /
# Prod example: /projects/census-visualizer/
VITE_BASE_PATH=/

# Browser API base path
# Dev default: /api
# Prod example: /projects/census-visualizer/api
VITE_API_BASE=/api

# Path at which to look up PMTiles; can be local or remote
# Must start with / when GEO_ASSET_MODE=local
# Dev default: /geo
# Prod example: <STORAGE_SOLUTION_HOSTNAME>/census-visualizer/geo
VITE_GEO_BASE=/geo


### Geo tiles parameters
# PMTiles stored local or remote
GEO_ASSET_MODE=local

# If GEO_ASSET_MODE is local, where VITE_GEO_BASE mounts from (no trailing slash)
# Dev default: pipeline/geo/out
# Prod example: null
GEO_ASSET_DIR=pipeline/geo/out
